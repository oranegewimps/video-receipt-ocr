# コピーして .env を作成してください（.env はコミットしない）
#   copy .env.example .env

# ---- Gemini ----
# mock: 固定のサンプル結果を返す（外部通信なし・課金なし） / live: Gemini API を呼ぶ
GEMINI_MODE=mock
GEMINI_API_KEY=
# 安定版の Flash 系（2026-11 時点のモデル一覧で確認）
GEMINI_MODEL=gemini-3.8-flash
# 動画フレームの解像度: low | medium | high | ultra_high（空欄=API既定）。小さな文字が読めなければ上げる
GEMINI_MEDIA_RESOLUTION=
# 1秒あたりのサンプリングフレーム数（既定 1）
GEMINI_FPS=1
# 思考の深さ: minimal | low | medium | high（空欄=モデル既定）
GEMINI_THINKING_LEVEL=low
# 1回のAPI呼び出しのタイムアウト（秒）と、最大試行回数（初回を含む。429/5xx などで再試行）
GEMINI_TIMEOUT_SEC=300
GEMINI_MAX_ATTEMPTS=3
GEMINI_FILE_ACTIVE_TIMEOUT_SEC=300
# 音声トラックを除去してから送る（入力トークン削減）
STRIP_AUDIO=true
# 概算費用の単価（USD / 100万トークン、入力/出力）。出力単価は思考トークンにも適用。
# 2026-11 時点の公式料金表より。gemini-3.8-flash / 3.6-flash は 2027-01-01 から 1.50/7.50 に値上げ予定
GEMINI_PRICES=gemini-3.8-flash=0.75/3.75,gemini-3.6-flash=0.75/3.75,gemini-3.5-flash-lite=0.30/2.50,gemini-3.1-flash-lite=0.25/1.50

# ---- 認証 ----
# 招待コード（カンマ区切り）。「ラベル:コード」形式にすると使用量がラベル別に記録される
INVITE_CODES=taro:change-me-1,hanako:change-me-2
# セッションCookie署名用（未設定だと起動ごとにランダム→再起動でログアウト）
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=
# /admin/usage 用（X-Admin-Token ヘッダ）。空欄なら管理エンドポイントは無効
ADMIN_TOKEN=
# HTTPS 配信時は true
COOKIE_SECURE=false

# ---- 上限 ----
DAILY_LIMIT_PER_USER=10
DAILY_LIMIT_TOTAL=50
MAX_CONCURRENT_JOBS=2
MAX_UPLOAD_MB=500
MAX_DURATION_SEC=180

# ---- 保存期間・掃除 ----
# 空欄なら %TEMP%\video-receipt-ocr（OneDrive 配下は起動時に拒否）
WORK_DIR=
# 使用量DB（トークン数等のみ。動画・抽出内容は保存しない）。空欄なら ./data/usage.db
USAGE_DB_PATH=
RESULT_TTL_MIN=60
TEMP_FILE_MAX_AGE_MIN=30
CLEANUP_INTERVAL_SEC=300

# ---- 売上管理モード（発行した領収書）の発行者情報 ----
# 表・CSVの発行者欄にはこの値を使う（動画からは読まない）。
# 動画に写った発行者名・登録番号がこの値と食い違うと「要確認」になる。未設定なら照合しない
SELF_NAME=
# T＋13桁（形式が違うと起動時にエラー）
SELF_INVOICE_NO=
SELF_ADDRESS=
# 売上区分の候補（カンマ区切り。空欄なら既定の候補）
SALES_CATEGORIES=

# ---- 国税庁 インボイス照合（任意。経費精算モードのみ） ----
# アプリケーションIDがある場合のみ照合する（live モード時のみ）
NTA_APP_ID=

# ---- ffmpeg（PATH にない場合のみフルパスを指定） ----
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
